# ==============================================================================
# UK-GED - CONFIGURATION ENVIRONNEMENT : STAGING (PRÉPRODUCTION)
# Instance de test avant validation de production
# ==============================================================================
NODE_ENV=staging
PORT=5001
APP_VERSION=1.0.0
APP_URL=https://staging-ged.universite.edu

# Base de données de Staging strictement isolée de la Production
DATABASE_PATH=./data/staging/uk_ged_staging.db

# Répertoire de stockage des fichiers uploadés de Staging
STORAGE_PATH=./uploads/staging

# Sauvegardes de Staging
BACKUP_DIR=../backups/staging

# Clé de signature JWT Staging
JWT_SECRET=uk_ged_staging_secret_key_universite_kindia_2026_preprod
JWT_EXPIRES_IN=24h

# Configuration de rétention des backups de Staging (jours)
BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_WEEKLY_WEEKS=4
BACKUP_RETENTION_MONTHLY_MONTHS=3

# ONLYOFFICE Document Server
ONLYOFFICE_DOCUMENT_SERVER_URL=https://onlyoffice-staging.universite.edu
ONLYOFFICE_JWT_SECRET=uk_ged_onlyoffice_staging_secret_2026
ONLYOFFICE_CALLBACK_URL=https://staging-ged.universite.edu
