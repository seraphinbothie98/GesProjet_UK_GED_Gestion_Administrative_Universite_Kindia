# UK-GED - Université de Kindia Configuration Example
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# ONLYOFFICE Docs Document Server Configuration
# URL of ONLYOFFICE Document Server (e.g., http://localhost:80 or your remote server)
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:80

# Secret key for ONLYOFFICE JWT security (match the Secret in ONLYOFFICE local.json)
ONLYOFFICE_JWT_SECRET=your_onlyoffice_jwt_secret_here
ONLYOFFICE_JWT_HEADER=Authorization

# Backend callback URL reachable from the ONLYOFFICE server container/host
ONLYOFFICE_CALLBACK_URL=http://localhost:5000
