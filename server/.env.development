# ==============================================================================
# UK-GED - CONFIGURATION ENVIRONNEMENT : DÉVELOPPEMENT LOCAL
# ==============================================================================
NODE_ENV=development
PORT=5000
APP_VERSION=1.0.0
APP_URL=http://localhost:3000

# Base de données SQLite locale de développement (isolée)
DATABASE_PATH=./data/dev/uk_ged_dev.db

# Répertoire de stockage des fichiers uploadés de développement
STORAGE_PATH=./uploads/dev

# Sauvegardes de développement
BACKUP_DIR=../backups/dev

# Clé de signature JWT
JWT_SECRET=uk_ged_dev_secret_key_universite_kindia_2026
JWT_EXPIRES_IN=24h

# ONLYOFFICE Document Server
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:80
ONLYOFFICE_JWT_SECRET=uk_ged_onlyoffice_dev_secret
ONLYOFFICE_CALLBACK_URL=http://host.docker.internal:5000
