# ==============================================================================
# UK-GED - CONFIGURATION ENVIRONNEMENT : PRODUCTION (ged.universite.edu)
# ATTENTION : Ne jamais committer ce fichier avec des identifiants réels.
# Copiez ce fichier vers .env.production sur le serveur sécurisé.
# ==============================================================================
NODE_ENV=production
PORT=5000
APP_VERSION=1.0.0
APP_URL=https://ged.universite.edu

# Base de données de Production (Fichier local sécurisé ou PostgreSQL)
DATABASE_PATH=./data/prod/uk_ged_production.db
# Ou pour PostgreSQL :
# DATABASE_URL=postgresql://ged_user:MOT_DE_PASSE_SECURISE@db.universite.edu:5432/uk_ged_prod?sslmode=require

# Répertoire de stockage persistant des documents de Production
STORAGE_PATH=/var/uk_ged/storage/prod

# Répertoire des sauvegardes de Production
BACKUP_DIR=/var/uk_ged/backups/prod

# Clé de signature JWT cryptographique haute sécurité (OBLIGATOIRE EN PRODUCTION)
JWT_SECRET=GENERER_UNE_CLE_SECRETE_ALEATOIRE_DE_64_CARACTERES_HEX

# Durée de validité des sessions
JWT_EXPIRES_IN=12h

# Politique de Rétention des Sauvegardes de Production
BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_WEEKLY_WEEKS=12
BACKUP_RETENTION_MONTHLY_MONTHS=12

# ONLYOFFICE Document Server Production
ONLYOFFICE_DOCUMENT_SERVER_URL=https://onlyoffice.universite.edu
ONLYOFFICE_JWT_SECRET=GENERER_SECRET_ONLYOFFICE_PRODUCTION
ONLYOFFICE_CALLBACK_URL=https://ged.universite.edu
